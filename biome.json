{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.min.js",
      "!**/*.html",
      "!**/static_src/images",
      "!**/static_src/tailwind",
      "!**/javascript/esm",
      "!**/javascript/vendor",
      "!**/public",
      "!**/site.webmanifest",
      "!**/settings.local.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "indentStyle": "space"
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off",
        "useArrowFunction": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noInnerDeclarations": "off"
      },
      "style": {
        "useTemplate": "off",
        "useConst": "off"
      },
      "suspicious": {
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "es5"
    },
    "globals": ["define", "htmx", "Alpine", "tinymce"]
  }
}
